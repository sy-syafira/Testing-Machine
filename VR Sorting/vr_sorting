
/*
  JIG SORTING VR 100K - ARDUINO NANO

  DATA 1 : Resistansi total VR (Pin 1 - Pin 3)
  DATA 2 : Estimasi resistansi wiper (Pin 2 - Pin 3)
  RASIO  : Data 2 / Data 1 * 100%

  RASIO <= 28% : NG (LED MERAH)
  RASIO >  28% : OK (LED HIJAU)

  Setelah hasil keluar, tunggu 3 detik.
  LED mati dan sistem siap memeriksa VR berikutnya.

  WIRING:
  A1 = Titik resistor referensi 10k dan ujung VR
  A0 = Wiper VR (pin 2)
  VR pin 3 = GND
  D5 = Tombol ke GND
  D8 = LED hijau melalui resistor 220-330 ohm
  D9 = LED merah melalui resistor 220-330 ohm

  Kapasitor 0.1uF:
  A1 ke GND
  A0 ke GND
*/

const byte PIN_DATA1  = A1;
const byte PIN_WIPER  = A0;
const byte PIN_BUTTON = 5;

const byte LED_OK = 8;
const byte LED_NG = 9;

// Nilai aktual resistor referensi yang sudah diukur
const float R_REFERENSI = 9850.0;  // ohm

// Batas klasifikasi
const float BATAS_RATIO = 28.0;

// ADC Arduino Nano 10-bit
const float ADC_MAX = 1023.0;

// Jumlah sampel ADC
const byte JUMLAH_SAMPLE = 8;

// Waktu menunggu penggantian VR
const unsigned long WAKTU_GANTI_VR = 3000;

// Status pengujian
enum Status {
  SIAP_DATA1,
  SIAP_DATA2,
  HASIL
};

Status status = SIAP_DATA1;

float data1Ohm = 0.0;
float data2Ohm = 0.0;
float ratioPersen = 0.0;

int adcA1Terakhir = 0;
int adcA0Terakhir = 0;

unsigned long waktuHasil = 0;

// Debounce tombol
int tombolTerakhir = HIGH;
int tombolStabil = HIGH;
unsigned long waktuDebounce = 0;

const unsigned long DEBOUNCE_MS = 35;


// --------------------------------------------------
// MEMBACA ADC DENGAN RATA-RATA SAMPEL
// --------------------------------------------------
int bacaADC(byte pin) {
  // Buang pembacaan pertama setelah pindah kanal ADC
  analogRead(pin);
  delayMicroseconds(300);

  unsigned long total = 0;

  for (byte i = 0; i < JUMLAH_SAMPLE; i++) {
    total += analogRead(pin);
    delayMicroseconds(200);
  }

  return (int)((total + JUMLAH_SAMPLE / 2) / JUMLAH_SAMPLE);
}


// --------------------------------------------------
// MEMBACA DATA 1: RESISTANSI PIN 1-3
//
// Rangkaian:
// 5V -> resistor referensi -> A1 dan pin 1 VR
// pin 3 VR -> GND
// --------------------------------------------------
float bacaData1() {
  int adcA1 = bacaADC(PIN_DATA1);

  adcA1Terakhir = adcA1;

  if (adcA1 <= 0 || adcA1 >= 1023) {
    return -1.0;
  }

  float resistansi =
      R_REFERENSI * (float)adcA1 /
      (ADC_MAX - (float)adcA1);

  return resistansi;
}


// --------------------------------------------------
// MEMBACA DATA 2: RESISTANSI PIN 2-3
//
// A0 = wiper / pin tengah VR
// A1 = titik pin 1 VR
//
// Rumus:
// R2-3 = Rref * ADC_A0 / (1023 - ADC_A1)
//
// Berlaku untuk rangkaian pembagi tegangan di atas.
// --------------------------------------------------
float bacaData2() {
  // Baca A1 dan A0 untuk memperoleh nilai terbaru
  int adcA1 = bacaADC(PIN_DATA1);
  int adcA0 = bacaADC(PIN_WIPER);

  adcA1Terakhir = adcA1;
  adcA0Terakhir = adcA0;

  if (adcA1 < 0 || adcA1 >= 1023 ||
      adcA0 < 0 || adcA0 > adcA1) {
    return -1.0;
  }

  float resistansi =
      R_REFERENSI * (float)adcA0 /
      (ADC_MAX - (float)adcA1);

  return resistansi;
}


// --------------------------------------------------
// RESET KE KONDISI SIAP
// --------------------------------------------------
void resetPengujian() {
  data1Ohm = 0.0;
  data2Ohm = 0.0;
  ratioPersen = 0.0;

  digitalWrite(LED_OK, LOW);
  digitalWrite(LED_NG, LOW);

  status = SIAP_DATA1;

  Serial.println();
  Serial.println(F("--------------------------------"));
  Serial.println(F("SIAP MENGUJI VR BERIKUTNYA"));
  Serial.println(F("Pasang VR, lalu tekan tombol."));
  Serial.println(F("Tekan tombol untuk DATA 1."));
  Serial.println(F("--------------------------------"));
}


// --------------------------------------------------
// CETAK HASIL
// --------------------------------------------------
void tampilkanHasil() {
  Serial.println();
  Serial.println(F("========== HASIL PENGUJIAN =========="));

  Serial.print(F("ADC A1       : "));
  Serial.println(adcA1Terakhir);

  Serial.print(F("ADC A0       : "));
  Serial.println(adcA0Terakhir);

  Serial.print(F("Data 1       : "));
  Serial.print(data1Ohm / 1000.0, 2);
  Serial.println(F(" kOhm"));

  Serial.print(F("Data 2       : "));
  Serial.print(data2Ohm / 1000.0, 2);
  Serial.println(F(" kOhm"));

  Serial.print(F("Rasio Data 2 : "));
  Serial.print(ratioPersen, 2);
  Serial.println(F(" %"));

  if (ratioPersen <= BATAS_RATIO) {
    digitalWrite(LED_NG, HIGH);
    digitalWrite(LED_OK, LOW);

    Serial.println(F("HASIL        : NG"));
    Serial.println(F("LED MERAH ON"));
  } else {
    digitalWrite(LED_OK, HIGH);
    digitalWrite(LED_NG, LOW);

    Serial.println(F("HASIL        : OK"));
    Serial.println(F("LED HIJAU ON"));
  }

  Serial.println(F("Hasil tampil selama 3 detik."));
  Serial.println(F("====================================="));

  waktuHasil = millis();
  status = HASIL;
}


// --------------------------------------------------
// MEMBACA TEKANAN TOMBOL DENGAN DEBOUNCE
// --------------------------------------------------
bool tombolDitekan() {
  int pembacaan = digitalRead(PIN_BUTTON);

  if (pembacaan != tombolTerakhir) {
    waktuDebounce = millis();
    tombolTerakhir = pembacaan;
  }

  if ((millis() - waktuDebounce) > DEBOUNCE_MS) {
    if (pembacaan != tombolStabil) {
      tombolStabil = pembacaan;

      if (tombolStabil == LOW) {
        return true;
      }
    }
  }

  return false;
}


// --------------------------------------------------
// SETUP
// --------------------------------------------------
void setup() {
  pinMode(PIN_BUTTON, INPUT_PULLUP);

  pinMode(LED_OK, OUTPUT);
  pinMode(LED_NG, OUTPUT);

  digitalWrite(LED_OK, LOW);
  digitalWrite(LED_NG, LOW);

  Serial.begin(9600);

  delay(500);

  Serial.println(F("JIG PENGUKURAN VR"));
  Serial.println(F("Arduino Nano"));
  Serial.println(F("Resistor referensi: 9.85 kOhm"));
  Serial.println(F("Batas NG: rasio <= 28%"));
  Serial.println(F("Batas OK: rasio > 28%"));

  resetPengujian();
}


// --------------------------------------------------
// LOOP UTAMA
// --------------------------------------------------
void loop() {
  // Jika hasil sudah ditampilkan selama 3 detik,
  // otomatis bersiap menguji VR berikutnya.
  if (status == HASIL) {
    if (millis() - waktuHasil >= WAKTU_GANTI_VR) {
      resetPengujian();
    }
    return;
  }

  if (!tombolDitekan()) {
    return;
  }

  // ----------------------------------------------
  // TAHAP 1: DATA 1
  // ----------------------------------------------
  if (status == SIAP_DATA1) {
    Serial.println();
    Serial.println(F("Membaca DATA 1..."));

    data1Ohm = bacaData1();

    if (data1Ohm <= 0.0) {
      Serial.println(F("ERROR: ADC A1 tidak valid."));
      Serial.println(F("Periksa wiring dan posisi VR."));
      return;
    }

    Serial.print(F("ADC A1       : "));
    Serial.println(adcA1Terakhir);

    Serial.print(F("DATA 1       : "));
    Serial.print(data1Ohm / 1000.0, 2);
    Serial.println(F(" kOhm"));

    Serial.println(F("Putar VR ke posisi 90 derajat."));
    Serial.println(F("Tekan tombol untuk membaca DATA 2."));

    status = SIAP_DATA2;
  }

  // ----------------------------------------------
  // TAHAP 2: DATA 2 DAN HASIL
  // ----------------------------------------------
  else if (status == SIAP_DATA2) {
    Serial.println();
    Serial.println(F("Membaca DATA 2..."));

    data2Ohm = bacaData2();

    if (data2Ohm < 0.0) {
      Serial.println(F("ERROR: pembacaan ADC tidak valid."));
      Serial.println(F("Periksa wiring A0, A1, dan GND."));
      return;
    }

    if (data1Ohm <= 0.0) {
      Serial.println(F("ERROR: DATA 1 tidak valid."));
      resetPengujian();
      return;
    }

    ratioPersen = (data2Ohm / data1Ohm) * 100.0;

    tampilkanHasil();
  }
}
