#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <avr/wdt.h>

// =====================================================
// PIN ARDUINO NANO
// =====================================================
#define STEP_PIN        3
#define DIR_PIN         2

#define ENCODER_A       4
#define ENCODER_B       5
#define ENCODER_SW      6

#define RESET_BUTTON    7

// =====================================================
// LCD I2C
// =====================================================
LiquidCrystal_I2C lcd(0x27, 16, 2);

// =====================================================
// ARAH MOTOR
// Sesuaikan jika arah motor terbalik
// =====================================================
#define DIR_ZERO        LOW
#define DIR_MAX         HIGH

// =====================================================
// KALIBRASI PANJANG
// Nilai awal berdasarkan pengukuran sebelumnya:
// LCD 10 cm, aktual 7.5 cm
// =====================================================
#define STEPS_PER_CM    133.0

// =====================================================
// PENGALI ROTARY ENCODER BERDASARKAN MODE
// =====================================================
#define ROD_ENCODER_STEP_MULTIPLIER       250
#define PRINTING_ENCODER_STEP_MULTIPLIER   50

int encoderStepMultiplier = ROD_ENCODER_STEP_MULTIPLIER;


// ROD = EXTEND & RETRACT
// 0 = EXTEND & RETRACT TEST
// 1 = PRINTING BOX TEST
int selectedMode = 0;

// =====================================================
// PENGATURAN KECEPATAN MOTOR
// =====================================================
#define MIN_STEP_DELAY_US       100
#define STEP_PROCESS_OVERHEAD_US 15

// =====================================================
// STATE PROGRAM
// =====================================================
enum State
{
  SELECT_MODE,
  ZERO_WARNING,
  FIND_ZERO,
  MAX_WARNING,
  FIND_MAX,
  SET_CYCLE_TIME,
  SET_TEST_HOUR,
  SET_TEST_MINUTE,
  READY,
  RUNNING,
  FINISHED
};

State state = SELECT_MODE;

// =====================================================
// POSISI MOTOR DALAM STEP
// =====================================================
long currentPosition = 0;
long maxPosition = 0;

// =====================================================
// SETTING CPM
// =====================================================
int cyclePerMinute = 5;

const int minCPM = 1;
const int maxCPM = 60;

// =====================================================
// DURASI PENGUJIAN
// =====================================================
int testHours = 0;
int testMinutes = 1;

unsigned long testStartTime = 0;
unsigned long testDuration = 0;

// =====================================================
// COUNTER CYCLE
// =====================================================
unsigned long cycleCount = 0;

// =====================================================
// ROTARY ENCODER DAN BUTTON
// =====================================================
int lastEncoderA = HIGH;

unsigned long lastButtonTime = 0;
const unsigned long buttonDelay = 250;

// =====================================================
// FUNCTION DECLARATION
// =====================================================
void selectModeProcess();
void zeroWarningProcess();
void findZeroProcess();
void maxWarningProcess();
void findMaxProcess();

void setCycleTimeProcess();
void setTestHourProcess();
void setTestMinuteProcess();

void readyProcess();
void runProcess();
void finishProcess();

void stepMotor(unsigned long stepDelay);
void moveToMax();
void moveToZero();
void moveToPosition(long targetPosition);

void showReady();
void showRunning();
void showPosition(const char* title);

void checkResetButton();
void resetArduino();

bool encoderButtonPressed();
int readEncoder();

void printTwoDigits(int value);
void printLengthCm(long position);

unsigned long calculateStepDelay();

// =====================================================
// SETUP
// =====================================================
void setup()
{
  pinMode(STEP_PIN, OUTPUT);
  pinMode(DIR_PIN, OUTPUT);

  digitalWrite(STEP_PIN, LOW);
  digitalWrite(DIR_PIN, DIR_ZERO);

  pinMode(ENCODER_A, INPUT_PULLUP);
  pinMode(ENCODER_B, INPUT_PULLUP);
  pinMode(ENCODER_SW, INPUT_PULLUP);

  pinMode(RESET_BUTTON, INPUT_PULLUP);

  lcd.init();
  lcd.backlight();

  lastEncoderA = digitalRead(ENCODER_A);

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("ANTENNA TEST");
  lcd.setCursor(0, 1);
  lcd.print("INITIALIZING...");
  delay(1000);

  lcd.clear();
}

// =====================================================
// LOOP
// =====================================================
void loop()
{
  checkResetButton();

  switch (state)
  {
    case SELECT_MODE:
      selectModeProcess();
      break;

    case ZERO_WARNING:
      zeroWarningProcess();
      break;

    case FIND_ZERO:
      findZeroProcess();
      break;

    case MAX_WARNING:
      maxWarningProcess();
      break;

    case FIND_MAX:
      findMaxProcess();
      break;

    case SET_CYCLE_TIME:
      setCycleTimeProcess();
      break;

    case SET_TEST_HOUR:
      setTestHourProcess();
      break;

    case SET_TEST_MINUTE:
      setTestMinuteProcess();
      break;

    case READY:
      readyProcess();
      break;

    case RUNNING:
      runProcess();
      break;

    case FINISHED:
      finishProcess();
      break;
  }
}

// =====================================================
// PILIH MODE TEST
// =====================================================
void selectModeProcess()
{
  int encoderMove = readEncoder();

  if (encoderMove != 0)
  {
    selectedMode = (selectedMode == 0) ? 1 : 0;
    lcd.clear();
  }

  lcd.setCursor(0, 0);
  lcd.print("SELECT TEST MODE");

  lcd.setCursor(0, 1);

  if (selectedMode == 0)
  {
    lcd.print(">EXTEND&RETRACT TEST       ");
  }
  else
  {
    lcd.print(">PRINTING BOX   ");
  }

  if (encoderButtonPressed())
  {
    if (selectedMode == 0)
    {
      encoderStepMultiplier =
        ROD_ENCODER_STEP_MULTIPLIER;
    }
    else
    {
      encoderStepMultiplier =
        PRINTING_ENCODER_STEP_MULTIPLIER;
    }

    currentPosition = 0;
    maxPosition = 0;
    cycleCount = 0;

    testHours = 0;
    testMinutes = 1;
    cyclePerMinute = 5;

    state = ZERO_WARNING;
    lcd.clear();
  }
}

// =====================================================
// PERINGATAN SEBELUM FIND ZERO
// Pastikan dinamo OFF
// =====================================================
void zeroWarningProcess()
{
  lcd.setCursor(0, 0);
  lcd.print("TURN OFF DINAMO ");

  lcd.setCursor(0, 1);
  lcd.print("PRESS OK TO SET ");

  if (encoderButtonPressed())
  {
    currentPosition = 0;

    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("FIND ZERO");
    lcd.setCursor(0, 1);
    lcd.print("Turn Encoder");

    delay(500);

    state = FIND_ZERO;
  }
}

// =====================================================
// FIND ZERO
// Putar encoder untuk mengatur titik nol
// Tekan encoder untuk menyimpan
// =====================================================
void findZeroProcess()
{
  int encoderMove = readEncoder();

  if (encoderMove > 0)
  {
    digitalWrite(DIR_PIN, DIR_MAX);

    for (int i = 0; i < encoderStepMultiplier; i++)
    {
      stepMotor(500);
      currentPosition++;
    }
  }
  else if (encoderMove < 0)
  {
    digitalWrite(DIR_PIN, DIR_ZERO);

    for (int i = 0; i < encoderStepMultiplier; i++)
    {
      stepMotor(500);
      currentPosition--;
    }
  }

  showPosition("FIND ZERO");

  if (encoderButtonPressed())
  {
    // Posisi fisik saat ini ditetapkan sebagai titik nol
    currentPosition = 0;

    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("ZERO SAVED");

    lcd.setCursor(0, 1);
    lcd.print("POSITION: 0 cm");

    delay(1000);

    // Setelah zero tersimpan, minta dinamo dinyalakan
    state = MAX_WARNING;
    lcd.clear();
  }
}

// =====================================================
// PERINGATAN SEBELUM FIND MAX
// Pastikan dinamo ON sebelum menekan OK
// =====================================================
void maxWarningProcess()
{
  lcd.setCursor(0, 0);
  lcd.print("TURN ON DINAMO  ");

  lcd.setCursor(0, 1);
  lcd.print("PRESS OK FOR MAX");

  if (encoderButtonPressed())
  {
    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("FIND MAX");

    lcd.setCursor(0, 1);
    lcd.print("Turn Encoder");

    delay(500);

    state = FIND_MAX;
  }
}

// =====================================================
// FIND MAX
// Putar encoder sampai posisi maksimum
// Tekan encoder untuk menyimpan
// =====================================================
void findMaxProcess()
{
  int encoderMove = readEncoder();

  if (encoderMove > 0)
  {
    digitalWrite(DIR_PIN, DIR_MAX);

    for (int i = 0; i < encoderStepMultiplier; i++)
    {
      stepMotor(500);
      currentPosition++;
    }
  }
  else if (encoderMove < 0)
  {
    digitalWrite(DIR_PIN, DIR_ZERO);

    for (int i = 0; i < encoderStepMultiplier; i++)
    {
      stepMotor(500);
      currentPosition--;
    }
  }

  showPosition("FIND MAX");

  if (encoderButtonPressed())
  {
    maxPosition = currentPosition;

    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("MAX SAVED");

    lcd.setCursor(0, 1);
    lcd.print("MAX:");

    printLengthCm(maxPosition);
    lcd.print(" cm");

    delay(1000);

    // Kembali ke titik nol setelah max disimpan
    moveToZero();

    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("SET CYCLE/MIN");

    lcd.setCursor(0, 1);
    lcd.print(cyclePerMinute);
    lcd.print(" CPM");

    delay(500);

    state = SET_CYCLE_TIME;
  }
}

// =====================================================
// SET CYCLE PER MINUTE
// =====================================================
void setCycleTimeProcess()
{
  int encoderMove = readEncoder();

  if (encoderMove > 0)
  {
    cyclePerMinute++;

    if (cyclePerMinute > maxCPM)
    {
      cyclePerMinute = maxCPM;
    }
  }
  else if (encoderMove < 0)
  {
    cyclePerMinute--;

    if (cyclePerMinute < minCPM)
    {
      cyclePerMinute = minCPM;
    }
  }

  lcd.setCursor(0, 0);
  lcd.print("CYCLE / MIN     ");

  lcd.setCursor(0, 1);
  lcd.print(cyclePerMinute);
  lcd.print(" CPM           ");

  if (encoderButtonPressed())
  {
    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("SET TEST HOUR");

    lcd.setCursor(0, 1);
    lcd.print("HOUR:");

    printTwoDigits(testHours);

    delay(300);

    state = SET_TEST_HOUR;
  }
}

// =====================================================
// SET DURASI JAM
// =====================================================
void setTestHourProcess()
{
  int encoderMove = readEncoder();

  if (encoderMove > 0)
  {
    testHours++;

    if (testHours > 99)
    {
      testHours = 0;
    }
  }
  else if (encoderMove < 0)
  {
    testHours--;

    if (testHours < 0)
    {
      testHours = 99;
    }
  }

  lcd.setCursor(0, 0);
  lcd.print("SET TEST HOUR   ");

  lcd.setCursor(0, 1);
  lcd.print("HOUR:");

  printTwoDigits(testHours);
  lcd.print("            ");

  if (encoderButtonPressed())
  {
    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("SET TEST MIN");

    lcd.setCursor(0, 1);
    lcd.print("MIN:");

    printTwoDigits(testMinutes);

    delay(300);

    state = SET_TEST_MINUTE;
  }
}

// =====================================================
// SET DURASI MENIT
// =====================================================
void setTestMinuteProcess()
{
  int encoderMove = readEncoder();

  if (encoderMove > 0)
  {
    testMinutes++;

    if (testMinutes > 59)
    {
      testMinutes = 0;
    }
  }
  else if (encoderMove < 0)
  {
    testMinutes--;

    if (testMinutes < 0)
    {
      testMinutes = 59;
    }
  }

  lcd.setCursor(0, 0);
  lcd.print("SET TEST MIN    ");

  lcd.setCursor(0, 1);
  lcd.print("MIN:");

  printTwoDigits(testMinutes);
  lcd.print("            ");

  if (encoderButtonPressed())
  {
    if (testHours == 0 && testMinutes == 0)
    {
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("TIME NOT ZERO");

      lcd.setCursor(0, 1);
      lcd.print("SET AGAIN");

      delay(1000);
      lcd.clear();
      return;
    }

    testDuration =
      ((unsigned long)testHours * 3600UL
      + (unsigned long)testMinutes * 60UL)
      * 1000UL;

    showReady();
    state = READY;
  }
}

// =====================================================
// TAMPILAN READY
// =====================================================
void showReady()
{
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("READY TO START");

  lcd.setCursor(0, 1);
  lcd.print("OK=START ");

  lcd.print(cyclePerMinute);
  lcd.print(" CPM");
}

// =====================================================
// READY
// =====================================================
void readyProcess()
{
  if (encoderButtonPressed())
  {
    cycleCount = 0;
    testStartTime = millis();

    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("TEST RUNNING");

    lcd.setCursor(0, 1);
    lcd.print("PLEASE WAIT");

    delay(500);

    state = RUNNING;
  }
}

// =====================================================
// RUNNING
// Satu cycle = ZERO -> MAX -> ZERO
// =====================================================
void runProcess()
{
  // Cek waktu sebelum memulai cycle baru
  if (millis() - testStartTime >= testDuration)
  {
    state = FINISHED;
    lcd.clear();
    return;
  }

  // Bergerak dari zero ke max
  moveToMax();

  // Bergerak dari max kembali ke zero
  moveToZero();

  // Cycle dihitung setelah kembali ke zero
  cycleCount++;

  showRunning();

  // Durasi dicek lagi setelah satu cycle selesai
  if (millis() - testStartTime >= testDuration)
  {
    state = FINISHED;
    lcd.clear();
  }
}

// =====================================================
// TAMPILAN STATUS RUNNING
// =====================================================
void showRunning()
{
  unsigned long elapsed =
    millis() - testStartTime;

  unsigned long remaining = 0;

  if (elapsed < testDuration)
  {
    remaining = testDuration - elapsed;
  }

  unsigned long totalSeconds =
    remaining / 1000UL;

  unsigned int hours =
    totalSeconds / 3600UL;

  unsigned int minutes =
    (totalSeconds % 3600UL) / 60UL;

  unsigned int seconds =
    totalSeconds % 60UL;

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("LEFT ");

  printTwoDigits(hours);
  lcd.print(":");
  printTwoDigits(minutes);
  lcd.print(":");
  printTwoDigits(seconds);

  lcd.setCursor(0, 1);
  lcd.print("CYCLE:");
  lcd.print(cycleCount);

  lcd.print("        ");
}

// =====================================================
// SELESAI
// =====================================================
void finishProcess()
{
  lcd.setCursor(0, 0);
  lcd.print("TEST FINISHED   ");

  lcd.setCursor(0, 1);
  lcd.print("CYCLE:");
  lcd.print(cycleCount);
  lcd.print("        ");

  if (encoderButtonPressed())
  {
    currentPosition = 0;
    maxPosition = 0;
    cycleCount = 0;

    testHours = 0;
    testMinutes = 1;
    cyclePerMinute = 5;

    lcd.clear();

    state = SELECT_MODE;
  }
}

// =====================================================
// TAMPILKAN POSISI DALAM CM
// =====================================================
void showPosition(const char* title)
{
  lcd.setCursor(0, 0);
  lcd.print(title);
  lcd.print("            ");

  lcd.setCursor(0, 1);
  lcd.print("Length:");

  printLengthCm(currentPosition);
  lcd.print(" cm     ");
}

// =====================================================
// KONVERSI STEP KE CM
// =====================================================
void printLengthCm(long position)
{
  float lengthCm =
    (float)position / STEPS_PER_CM;

  lcd.print(lengthCm, 2);
}

// =====================================================
// HITUNG DELAY MOTOR BERDASARKAN CPM
// Target CPM merupakan estimasi; hasil aktual
// dipengaruhi beban, driver, motor, dan overhead.
// =====================================================
unsigned long calculateStepDelay()
{
  unsigned long cycleTimeUs =
    60000000UL / (unsigned long)cyclePerMinute;

  unsigned long totalSteps =
    (unsigned long)abs(maxPosition) * 2UL;

  if (totalSteps == 0)
  {
    return 500;
  }

  // Waktu target untuk satu step, termasuk HIGH + LOW
  unsigned long targetStepTimeUs =
    cycleTimeUs / totalSteps;

  unsigned long delayUs = 0;

  if (targetStepTimeUs > STEP_PROCESS_OVERHEAD_US)
  {
    delayUs =
      (targetStepTimeUs - STEP_PROCESS_OVERHEAD_US) / 2UL;
  }
  else
  {
    delayUs = MIN_STEP_DELAY_US;
  }

  if (delayUs < MIN_STEP_DELAY_US)
  {
    delayUs = MIN_STEP_DELAY_US;
  }

  return delayUs;
}

// =====================================================
// GERAK ZERO -> MAX
// =====================================================
void moveToMax()
{
  unsigned long stepDelay = calculateStepDelay();

  if (maxPosition > currentPosition)
  {
    digitalWrite(DIR_PIN, DIR_MAX);

    while (currentPosition < maxPosition)
    {
      stepMotor(stepDelay);
      currentPosition++;
    }
  }
  else if (maxPosition < currentPosition)
  {
    digitalWrite(DIR_PIN, DIR_ZERO);

    while (currentPosition > maxPosition)
    {
      stepMotor(stepDelay);
      currentPosition--;
    }
  }
}

// =====================================================
// GERAK KEMBALI KE ZERO
// =====================================================
void moveToZero()
{
  unsigned long stepDelay = calculateStepDelay();

  if (currentPosition > 0)
  {
    digitalWrite(DIR_PIN, DIR_ZERO);

    while (currentPosition > 0)
    {
      stepMotor(stepDelay);
      currentPosition--;
    }
  }
  else if (currentPosition < 0)
  {
    digitalWrite(DIR_PIN, DIR_MAX);

    while (currentPosition < 0)
    {
      stepMotor(stepDelay);
      currentPosition++;
    }
  }

  currentPosition = 0;
}

// =====================================================
// GERAK KE POSISI TERTENTU
// =====================================================
void moveToPosition(long targetPosition)
{
  unsigned long stepDelay = calculateStepDelay();

  if (targetPosition > currentPosition)
  {
    digitalWrite(DIR_PIN, DIR_MAX);

    while (currentPosition < targetPosition)
    {
      stepMotor(stepDelay);
      currentPosition++;
    }
  }
  else if (targetPosition < currentPosition)
  {
    digitalWrite(DIR_PIN, DIR_ZERO);

    while (currentPosition > targetPosition)
    {
      stepMotor(stepDelay);
      currentPosition--;
    }
  }
}

// =====================================================
// STEP MOTOR
// =====================================================
void stepMotor(unsigned long stepDelay)
{
  checkResetButton();

  digitalWrite(STEP_PIN, HIGH);
  delayMicroseconds(stepDelay);

  digitalWrite(STEP_PIN, LOW);
  delayMicroseconds(stepDelay);
}

// =====================================================
// ROTARY ENCODER
// =====================================================
int readEncoder()
{
  int currentA = digitalRead(ENCODER_A);
  int result = 0;

  if (currentA != lastEncoderA)
  {
    lastEncoderA = currentA;

    if (currentA == LOW)
    {
      if (digitalRead(ENCODER_B) == HIGH)
      {
        result = 1;
      }
      else
      {
        result = -1;
      }
    }
  }

  return result;
}

// =====================================================
// TOMBOL OK PADA ROTARY ENCODER
// =====================================================
bool encoderButtonPressed()
{
  if (digitalRead(ENCODER_SW) == LOW)
  {
    if (millis() - lastButtonTime > buttonDelay)
    {
      lastButtonTime = millis();

      while (digitalRead(ENCODER_SW) == LOW)
      {
        checkResetButton();
        delay(5);
      }

      return true;
    }
  }

  return false;
}

// =====================================================
// TOMBOL RESET
// =====================================================
void checkResetButton()
{
  if (digitalRead(RESET_BUTTON) == LOW)
  {
    delay(30);

    if (digitalRead(RESET_BUTTON) == LOW)
    {
      lcd.clear();

      lcd.setCursor(0, 0);
      lcd.print("RESET");

      lcd.setCursor(0, 1);
      lcd.print("PLEASE WAIT");

      delay(100);

      resetArduino();
    }
  }
}

// =====================================================
// RESET ARDUINO DENGAN WATCHDOG
// =====================================================
void resetArduino()
{
  wdt_enable(WDTO_15MS);

  while (1)
  {
  }
}

// =====================================================
// CETAK ANGKA 2 DIGIT
// =====================================================
void printTwoDigits(int value)
{
  if (value < 10)
  {
    lcd.print("0");
  }

  lcd.print(value);
}
